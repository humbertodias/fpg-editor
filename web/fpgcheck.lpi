<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="/"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="fpgcheck"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
    </General>
    <BuildModes Count="1">
      <Item1 Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <Units Count="2">
      <Unit0>
        <Filename Value="fpgcheck.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit0>
      <Unit1>
        <Filename Value="ufpgformat.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit1>
    </Units>
    <CustomData Count="1">
      <Item1 Name="Pas2JSProject" Value="1"/>
    </CustomData>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="/"/>
    <Target FileExt=".js">
      <Filename Value="fpgcheck"/>
    </Target>
    <SearchPaths>
      <UnitOutputDirectory Value="lib/node"/>
    </SearchPaths>
    <CodeGeneration>
      <TargetCPU Value="ecmascript5"/>
      <TargetOS Value="nodejs"/>
    </CodeGeneration>
    <Other>
      <CustomOptions Value="-Jeutf-8 -Jirtl.js -Jc -Jminclude"/>
      <CompilerPath Value="pas2js"/>
    </Other>
  </CompilerOptions>
</CONFIG>
