<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="/"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="fpgweb"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
    </General>
    <BuildModes Count="1">
      <Item1 Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <Units Count="4">
      <Unit0>
        <Filename Value="fpgweb.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit0>
      <Unit1>
        <Filename Value="ufpgformat.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit1>
      <Unit2>
        <Filename Value="uviewer.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit2>
      <Unit3>
        <Filename Value="index.html"/>
        <IsPartOfProject Value="True"/>
        <CustomData Count="1">
          <Item1 Name="PasJSIsProjectHTMLFile" Value="1"/>
        </CustomData>
      </Unit3>
    </Units>
    <CustomData Count="2">
      <Item1 Name="Pas2JSProject" Value="1"/>
      <Item2 Name="PasJSWebBrowserProject" Value="1"/>
    </CustomData>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="/"/>
