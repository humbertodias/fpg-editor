      <Filename Value="fpgweb"/>
    </Target>
    <SearchPaths>
      <UnitOutputDirectory Value="lib/browser"/>
    </SearchPaths>
    <CodeGeneration>
      <TargetCPU Value="ecmascript5"/>
      <TargetOS Value="browser"/>
    </CodeGeneration>
    <Other>
      <CustomOptions Value="-Jeutf-8 -Jirtl.js -Jc -Jminclude"/>
      <CompilerPath Value="pas2js"/>
    </Other>
  </CompilerOptions>
</CONFIG>
